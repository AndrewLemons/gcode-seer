{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["typescript", "unicorn", "oxc"],
	"categories": {
		"correctness": "error"
	},
	"rules": {
		"curly": ["error", "all"],
		"eqeqeq": "error",
		"typescript/no-explicit-any": "error"
	},
	"ignorePatterns": ["dist/**", "coverage/**"]
}

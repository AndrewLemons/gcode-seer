{
	"name": "gcode-seer",
	"version": "0.1.0",
	"description": "Streaming, typed G-code analysis with printer constraints and explicit uncertainty.",
	"keywords": [
		"3d-printing",
		"analyzer",
		"bambu",
		"gcode",
		"typescript"
	],
	"license": "MIT",
	"files": [
		"dist",
		"src",
		"docs",
		"README.md",
		"CHANGELOG.md",
		"LICENSE"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "bun run scripts/build.ts",
		"typecheck": "bun --bun tsc --noEmit",
		"test": "bun test",
		"test:watch": "bun test --watch",
		"test:coverage": "bun test --coverage",
		"lint": "bun --bun oxlint --deny-warnings",
		"lint:fix": "bun --bun oxlint --fix",
		"format": "bun --bun oxfmt --write .",
		"format:check": "bun --bun oxfmt --check .",
		"check": "bun run format:check && bun run typecheck && bun run lint && bun run test:coverage && bun run build",
		"bench": "bun run build && bun scripts/benchmark.ts",
		"prepack": "bun run build",
		"pack:check": "bun run build && bun scripts/pack-check.ts",
		"prepare": "bun scripts/setup-hooks.ts",
		"commit:check": "bun scripts/check-commit.ts"
	},
	"devDependencies": {
		"@types/bun": "^1.4.2",
		"oxfmt": "^0.70.0",
		"oxlint": "^1.85.0",
		"typescript": "^6.0.3"
	},
	"engines": {
		"bun": ">=1.4.2"
	},
	"packageManager": "bun@1.4.2"
}
